---
import Site from '../../layouts/Site.astro';
---
<Site title="Analytics" current="analytics" wide description="Public page-read analytics for WhiteThroated.">
  <div class="analytics" id="analytics">
    <script is:inline>
      document.currentScript.parentElement.dataset.loading = '';
    </script>
    <h1>Analytics</h1>
    <p class="analytics-intro">Public page reads. Markdown requests are counted as agent reads; HTML page requests are counted as human reads.</p>
    <p class="analytics-muted">Counts are estimates based on the requested URL. Current aggregates, when configured, are available from the <a href="/api/analytics">analytics API</a>; this page's Markdown version does not include live counts.</p>
    <p id="analytics-status" class="analytics-muted" role="status">See the analytics API for counts.</p>
    <div class="analytics-stats" aria-label="All-time reads">
      <div class="analytics-card"><span>All reads</span><strong id="all-reads">—</strong></div>
      <div class="analytics-card"><span>Human</span><strong id="human-reads">—</strong></div>
      <div class="analytics-card"><span>Agent</span><strong id="agent-reads">—</strong></div>
    </div>
    <div class="analytics-share" aria-hidden="true"><span id="human-share"></span><span id="agent-share"></span></div>
    <p class="analytics-legend"><span><i class="dot human"></i> Human <span id="human-legend">—</span></span><span><i class="dot agent"></i> Agent <span id="agent-legend">—</span></span></p>

    <section class="analytics-section" aria-labelledby="trend-title">
      <div class="analytics-heading"><h2 id="trend-title">Reading trend</h2><p class="analytics-legend"><span><i class="dot human"></i> Human</span><span><i class="dot agent"></i> Agent</span></p></div>
      <div class="analytics-periods" role="group" aria-label="Reading trend time range">
        <button type="button" data-period="24h" aria-pressed="false">24 hours</button><button type="button" data-period="7d" aria-pressed="false">7 days</button><button type="button" data-period="30d" aria-pressed="true">30 days</button><button type="button" data-period="60d" aria-pressed="false">60 days</button><button type="button" data-period="90d" aria-pressed="false">90 days</button><button type="button" data-period="year" aria-pressed="false">This year</button>
      </div>
      <div class="analytics-panel analytics-chart"><svg id="reading-chart" viewBox="0 0 900 260" role="img" aria-label="Reading trend by date" preserveAspectRatio="none">
          <g class="loading-rows" aria-hidden="true" fill="var(--placeholder)">
            {[12, 65, 118, 171, 224].map(y => <g><rect x="8" y={y - 3} width="20" height="6" rx="3"/><rect x="38" y={y} width="852" height="1"/></g>)}
            <rect x="38" y="244" width="45" height="7" rx="3"/><rect x="845" y="244" width="45" height="7" rx="3"/>
          </g></svg><p id="chart-message" class="analytics-muted">Awaiting trend data.</p></div>
    </section>

    <section class="analytics-section" aria-labelledby="weekly-title">
      <div class="analytics-heading"><h2 id="weekly-title">Last 30 days</h2><span class="analytics-muted">Grouped by week · UTC</span></div>
      <div class="analytics-panel analytics-table-wrap"><table><thead><tr><th scope="col">Week</th><th scope="col">Total</th><th scope="col">Human</th><th scope="col">Agent</th></tr></thead><tbody class="loading-rows" aria-hidden="true">
          {Array.from({ length: 5 }, () => <tr>{Array.from({ length: 4 }, () => <td><i></i></td>)}</tr>)}
        </tbody><tbody id="weekly-rows"><tr><td colspan="4">See the analytics API for current counts.</td></tr></tbody></table></div>
    </section>

    <section class="analytics-section" aria-labelledby="pages-title">
      <div class="analytics-heading"><h2 id="pages-title">By page</h2><span class="analytics-muted">All-time aggregate</span></div>
      <div id="page-rows" class="analytics-panel">
        <div class="loading-rows" aria-hidden="true">
          {[1, 2, 3].map(() => <div class="analytics-page-row"><div class="analytics-row-top"><i></i><i></i></div><div class="analytics-bar"></div><i class="row-caption"></i></div>)}
        </div><p class="analytics-muted">Page reads will appear when analytics data is available.</p></div>
    </section>

    <section class="analytics-section" aria-labelledby="bots-title">
      <div class="analytics-heading"><h2 id="bots-title">AI agents &amp; bots</h2><span class="analytics-muted">Markdown reads · all-time aggregate</span></div>
      <div id="bot-rows" class="analytics-panel">
        <div class="loading-rows" aria-hidden="true">
          {[1, 2].map(() => <div class="analytics-bot-row analytics-row-top"><i></i><i></i></div>)}
        </div><p class="analytics-muted">See the analytics API for current named-agent counts.</p></div>
      <p class="analytics-muted analytics-note">Agent names are identified from known user-agent labels when available. A Markdown request is counted as an agent even if its agent is unknown.</p>
    </section>
    <noscript>Live analytics require JavaScript. Markdown and HTML request counts are available through the site's analytics API when configured.</noscript>
  </div>
  <script src="../../scripts/analytics.ts"></script>
</Site>

<style>
  .analytics { --placeholder: color-mix(in srgb, var(--wt-text) 13%, var(--wt-bg)); --line: #f4f4f4; --human: #0c4fec; --agent: #ec8b38; max-width: 66rem; margin: 0 auto; }
  :global(html[data-theme="dark"]) .analytics { --line: #313131; --human: #2160ff; --agent: #f29342; }
  .analytics h1 { font-weight: 600; margin-bottom: .5rem; }
  .analytics-intro, .analytics-muted, .analytics-legend { color: var(--wt-text-secondary); }
  .analytics-intro { margin: 0; }
  .analytics-muted { font-size: .85rem; }
  #analytics-status { margin: .65rem 0 2.5rem; }
  .analytics-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .analytics-card, .analytics-panel { border: 1px solid var(--line); border-radius: .85rem; padding: 1.5rem; }
  .analytics-card span, .analytics-card strong { display: block; }
  .analytics-card span { color: var(--wt-text-secondary); font-size: .85rem; }
  .analytics-card strong { font-size: 2rem; font-weight: 500; line-height: 1.3; }
  .analytics-share { display: flex; height: .5rem; margin-top: 1rem; background: var(--wt-surface); overflow: hidden; }
  .analytics-share, :global(.analytics-bar) { border-radius: 999px; overflow: hidden; }
  .analytics-share span:first-child { background: var(--human); } .analytics-share span:last-child { background: var(--agent); }
  .analytics-legend { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .85rem; margin: .6rem 0 0; }
  .dot { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; margin-right: .35rem; background: var(--human); }
  .dot.agent { background: var(--agent); }
  .analytics-section { margin-top: 3.5rem; }
  .analytics-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .analytics-heading h2 { font-size: 1.35rem; font-weight: 500; margin: 0; }
  .analytics-heading p { margin: 0; }
  .analytics-periods { display: inline-flex; flex-wrap: wrap; gap: .2rem; border: 1px solid var(--line); border-radius: .85rem; padding: .25rem; margin-bottom: 1rem; }
  .analytics-periods button { border-radius: .6rem; border: 0; background: transparent; color: var(--wt-text); padding: .55rem .7rem; font: inherit; font-size: .8rem; cursor: pointer; }
  .analytics-periods button[aria-pressed="true"] { background: var(--wt-surface); }
  .analytics-periods button:focus-visible { outline: 2px solid var(--wt-link); outline-offset: 2px; }
  .analytics-chart svg { width: 100%; height: 17rem; display: block; overflow: visible; }
  .analytics-chart p { text-align: center; margin: .5rem 0 0; }
  .analytics-table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; text-align: left; font-size: .9rem; }
  table { table-layout: fixed; min-width: 32rem; }
  th:first-child { width: 49%; }
  th, #weekly-rows :global(td) { padding: .75rem 1rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--wt-text-secondary); font-weight: 400; } #weekly-rows :global(tr:last-child td) { border-bottom: 0; }
  .analytics-panel > p { margin: 0; }
  .analytics-note { margin: .75rem 0 0; }
  :global(.analytics-page-row + .analytics-page-row), :global(.analytics-bot-row + .analytics-bot-row) { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: 1rem; }
  :global(.analytics-row-top) { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  :global(.analytics-bar) { display: flex; height: .45rem; background: var(--wt-surface); margin: .5rem 0; }
  :global(.analytics-bar-human) { background: var(--human); } :global(.analytics-bar-agent) { background: var(--agent); }
  :global(.analytics-row-sub) { color: var(--wt-text-secondary); font-size: .8rem; }
  /* Reserve the same space for pending, empty, and populated responses. */
  .analytics-table-wrap { height: 21rem; overflow: auto; }
  #page-rows, #bot-rows { overflow: auto; overflow-wrap: anywhere; }
  #page-rows { height: 21rem; }
  #bot-rows { height: 9rem; }
  #chart-message, #analytics-status { min-height: 1lh; }
  .loading-rows { display: none; }
  [data-loading] .loading-rows { display: block; }
  [data-loading] tbody.loading-rows { display: table-row-group; }
  [data-loading] #weekly-rows, [data-loading] .loading-rows + p { display: none; }
  .loading-rows td { padding: .75rem 1rem; border-bottom: 1px solid var(--line); }
  .loading-rows i { display: inline-block; height: .75em; width: 4ch; border-radius: .25rem; background: var(--placeholder); }
  .loading-rows td:first-child i { width: 17ch; }
  .loading-rows .analytics-row-top i:first-child { width: 30%; }
  .loading-rows .analytics-row-top { align-items: center; min-height: 1lh; }
  .loading-rows .row-caption { width: 9ch; }
  [data-loading] .analytics-share, .loading-rows .analytics-bar { background: var(--placeholder); }
  [data-loading] :is(.analytics-card strong, #human-legend, #agent-legend, #chart-message, #analytics-status) {
    position: relative; color: transparent;
  }
  [data-loading] :is(.analytics-card strong, #human-legend, #agent-legend, #chart-message, #analytics-status)::after {
    content: ''; position: absolute; inset-inline-start: 0; top: 50%; transform: translateY(-50%);
    height: .75em; width: min(100%, var(--width, 3ch)); border-radius: .25rem; background: var(--placeholder);
  }
  #human-legend, #agent-legend { display: inline-block; min-width: 12ch; }
  [data-loading] #chart-message::after { --width: 19ch; left: 50%; transform: translate(-50%, -50%); }
  [data-loading] #analytics-status::after { --width: 25ch; }
  @media (max-width: 40rem) { .analytics-stats { grid-template-columns: 1fr; } .analytics-section { margin-top: 2.5rem; } .analytics-chart svg { height: 12rem; } }
</style>
